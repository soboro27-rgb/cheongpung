generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  image        String?
  role         String   @default("PARENT")
  lat          Float?
  lng          Float?
  passBalance  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accounts         Account[]
  sessions         Session[]
  careProfile      CareProfile?
  matchesAsParent  Match[]          @relation("ParentMatches")
  passTransactions PassTransaction[]
  sentMessages     Message[]
  reviews          Review[]         @relation("ReviewerReviews")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model CareProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  bio           String?
  passPerHour   Int      @default(5)
  grade         String   @default("BASIC")
  reviewScore   Float    @default(0)
  reviewCount   Int      @default(0)
  adminVerified Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  certifications Certification[]
  matches        Match[]         @relation("CaregiverMatches")

  @@map("care_profiles")
}

model Certification {
  id            String    @id @default(cuid())
  careProfileId String
  type          String
  issuer        String
  verified      Boolean   @default(false)
  issuedAt      DateTime?
  createdAt     DateTime  @default(now())

  careProfile CareProfile @relation(fields: [careProfileId], references: [id], onDelete: Cascade)

  @@map("certifications")
}

model Match {
  id          String   @id @default(cuid())
  parentId    String
  caregiverId String
  status      String   @default("PENDING")
  passAmount  Int      @default(0)
  matchedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent           User            @relation("ParentMatches", fields: [parentId], references: [id])
  caregiver        CareProfile     @relation("CaregiverMatches", fields: [caregiverId], references: [id])
  passTransactions PassTransaction[]
  review           Review?
  messages         Message[]

  @@unique([parentId, caregiverId])
  @@map("matches")
}

model PassTransaction {
  id           String   @id @default(cuid())
  userId       String
  type         String
  amount       Int
  balanceAfter Int
  matchId      String?
  createdAt    DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id])
  match Match? @relation(fields: [matchId], references: [id])

  @@map("pass_transactions")
}

model Review {
  id         String   @id @default(cuid())
  matchId    String   @unique
  reviewerId String
  score      Int
  content    String?
  createdAt  DateTime @default(now())

  match    Match @relation(fields: [matchId], references: [id])
  reviewer User  @relation("ReviewerReviews", fields: [reviewerId], references: [id])

  @@map("reviews")
}

model Message {
  id       String   @id @default(cuid())
  matchId  String
  senderId String
  content  String
  isRead   Boolean  @default(false)
  sentAt   DateTime @default(now())

  match  Match @relation(fields: [matchId], references: [id])
  sender User  @relation(fields: [senderId], references: [id])

  @@map("messages")
}

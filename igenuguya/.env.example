DATABASE_URL=file:./dev.db
JWT_SECRET=change-this-in-production
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# 카카오 디벨로퍼스 앱 설정 (developers.kakao.com)
KAKAO_REST_API_KEY=
KAKAO_REDIRECT_URI=http://localhost:3000/api/auth/kakao/callback

# true면 실제 카카오 API 대신 목업 데이터로 화면/플로우만 확인 (심사 통과 전 로컬 개발용)
MOCK_KAKAO=true

# --- 앱인토스 미니앱 + SMS 경로 ---
# true면 실제 SMS를 보내지 않고 로그만 남김
MOCK_SMS=true
# Solapi (solapi.com) — 발신번호는 콘솔에서 사전 등록 필요
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=
# 미니앱 앱 이름 (CORS 허용 Origin 계산용)
MINIAPP_NAME=igenuguya-miniapp
# 사용자당 하루 발송 상한 / 1회 요청당 상한
SMS_DAILY_LIMIT=50
SMS_BATCH_LIMIT=20

# --- 앱인토스 미니앱 + SMS 경로 ---
# true면 실제 SMS를 보내지 않고 로그만 남김
MOCK_SMS=true
# Solapi (solapi.com) - 발신번호는 콘솔에서 사전 등록 필요
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=
# 미니앱 앱 이름 (CORS 허용 Origin 계산용)
MINIAPP_NAME=igenuguya-miniapp
# 1회 요청당 / 하루 발송 상한
SMS_BATCH_LIMIT=20
SMS_DAILY_LIMIT=50

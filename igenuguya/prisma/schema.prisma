generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ContactStatus: PENDING | SENT | KEEP | RELEASE | FAILED | EXPIRED

model User {
  id             Int      @id @default(autoincrement())
  kakaoId        String?  @unique
  anonKey        String?  @unique // 앱인토스 getAnonymousKey hash (미니앱 사용자)
  nickname       String
  thumbnailUrl   String?
  accessToken    String?
  refreshToken   String?
  tokenExpiresAt DateTime?
  createdAt      DateTime @default(now())
  credits        Int       @default(0) // 유료 발송권 잔액 (IAP로 충전)
  freeSentCount  Int       @default(0) // 오늘 무료 한도로 이미 보낸 건수
  freeSentDate   DateTime? // freeSentCount가 리셋된 날짜 (자정 기준 비교)
  batches        Batch[]
  purchases      Purchase[]
}

model Purchase {
  id           Int      @id @default(autoincrement())
  userId       Int
  productId    String
  credits      Int
  verified     Boolean  @default(false) // 서버 영수증 검증 여부 (아직 미구현 — 항상 false)
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])
}

model Batch {
  id          Int       @id @default(autoincrement())
  userId      Int
  messageText String
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id])
  contacts    Contact[]
}

model Contact {
  id          Int       @id @default(autoincrement())
  batchId     Int
  kakaoUuid   String?
  phone       String? // SMS 발송용 (앱인토스 미니앱 경로)
  nickname    String
  status      String    @default("PENDING")
  replyMessage String?  // 받는 분이 '메시지 남기기'로 남긴 답장 (KEEP일 때만)
  token       String    @unique
  sentAt      DateTime?
  reminderSentAt DateTime?
  respondedAt DateTime?
  createdAt   DateTime  @default(now())
  batch       Batch     @relation(fields: [batchId], references: [id])
  sendLogs    SendLog[]
}

model SendLog {
  id            Int      @id @default(autoincrement())
  contactId     Int
  provider      String   @default("kakao-friend-message") // kakao-friend-message | sms
  providerMsgId String?
  status        String
  errorCode     String?
  createdAt     DateTime @default(now())
  contact       Contact  @relation(fields: [contactId], references: [id])
}
